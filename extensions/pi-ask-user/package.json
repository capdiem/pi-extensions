{
  "name": "@capdiem/pi-ask-user",
  "version": "0.2.1",
  "private": true,
  "description": "An interactive ask_user form (Custom UI) for the Pi coding agent: turns grilling-skill questions into selectable options with recommended-answer hints — TUI full form, RPC sequential dialogs",
  "type": "module",
  "scripts": {
    "build": "bun run ../../scripts/build-package.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "ask-user",
    "custom-ui",
    "form",
    "form-selector",
    "interactive-form",
    "questionnaire",
    "grilling"
  ],
  "author": "capdiem <capdiem@live.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capdiem/pi-extensions.git",
    "directory": "extensions/pi-ask-user"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
